<?xml version="1.0" encoding="UTF-8"?>
<Page id="queue" label="Queue" icon="queue">
  <TwoColumn leftWidth="300">

    <!-- ── Left: header row + next button + stats + queue tabs ──────────────── -->
    <Left>
      <Stack fill="true">

        <!-- Header: open/closed status, total count, overflow actions -->
        <Stack direction="horizontal" gap="8" align="center" style="padding: 6px 10px; flex-shrink: 0; border-bottom: 1px solid #161616;">
          <Conditional showExpr="ms.get_or('open', true)">
            <Button label="Open"   icon="circle-check" actionKey="close_queue" variant="success"/>
            <Button label="Closed" icon="circle-x"     actionKey="open_queue"  variant="danger"/>
          </Conditional>
          <Text value="to_string(ms.collection('subscriber').count() + ms.collection('viewer').count()) + '/' + to_string(ms.get_or('max_size', 25))" style="muted"/>
          <Spacer/>
          <ActionMenu label="···" variant="ghost">
            <Action label="Shuffle"   key="shuffle" icon="shuffle"/>
            <Action label="Clear All" key="clear"   icon="trash-2" style="danger"/>
            <Action label="History"   navigateTo="history" icon="history"/>
          </ActionMenu>
        </Stack>

        <!-- Primary action: full-width prominent next button.
             afterStateKey/afterStateExpr pulls the just-popped level (the newest
             history entry — .last(), NOT .first(), which is the oldest) straight
             into the right-panel "selected" state, so it shows persistently in
             Level Info instead of only a transient toast/overlay. -->
        <Inset padding="8 12">
          <Button label="Next Level" icon="fast-forward" actionKey="next" variant="primary" fullWidth="true"
                  afterStateKey="selected" afterStateExpr="ms.collection('history').last()"/>
        </Inset>

        <!-- Add a level on someone's behalf (verbal/Discord/etc requests). No
             live chat message backs this, so subscriber status can't come
             from a badge — add_level.rhai resolves it via a live Helix
             check (twitch.is_subscriber) instead of guessing "viewer".
             TwoFieldForm submits both fields as one JSON arg and manages its
             own local state — see parser.ts for why that replaced a plain
             Input+Input+Button row. -->
        <Inset padding="0 12 8">
          <TwoFieldForm actionKey="add_level" field1Key="level_id" field1Placeholder="Level ID"
                        field2Key="username" field2Placeholder="Username" buttonLabel="Add" buttonIcon="plus"/>
        </Inset>

        <!-- Inline stats row -->
        <StatBar>
          <Stat icon="lucide:crown" valueExpr="ms.collection('subscriber').count()" label="subs"/>
          <Stat icon="lucide:users" valueExpr="ms.collection('viewer').count()"     label="viewers"/>
          <Stat icon="lucide:list"  valueExpr="ms.get_or('max_size', 25)"           label="max"/>
        </StatBar>

        <!-- Queue tabs (switching clears right-panel selection) -->
        <Tabs selectionKey="selected" variant="boxed">

          <!-- Subscriber Priority Mode off (the default) — splitting into two tabs
               is pointless (viewer/subscriber only affects which collection an
               entry lands in when the priority split is actually active; with it
               off, everyone lands in "viewer" regardless of real sub status), so
               show one unified list instead. sub_badge still marks genuine subs. -->
          <Tab label="Queue" icon="lucide:list" showExpr="!ms.get_or('sub_mode', false)">
            <List
              rowId="_id"
              primary="username"
              secondary="level_id"
              secondaryPrefix="#"
              platform="platform"
              positionField="position"
              badgeField="sub_badge"
              selectionKey="selected"
              emptyMessage="No requests yet">
              <Section dataExpr="(ms.collection('viewer').all() + ms.collection('subscriber').all()).map(|e| { e.sub_badge = if e.is_subscriber { 'SUB' } else { '' }; e })"/>
              <RowAction key="promote" argField="level_id" icon="arrow-up"/>
              <RowAction key="remove"  argField="level_id" style="danger" icon="trash-2"/>
            </List>
          </Tab>

          <Tab label="Subscribers" icon="lucide:crown" badgeExpr="ms.collection('subscriber').count()" showExpr="ms.get_or('sub_mode', false)">
            <List
              rowId="_id"
              primary="username"
              secondary="level_id"
              secondaryPrefix="#"
              platform="platform"
              positionField="position"
              badgeField="sub_badge"
              selectionKey="selected"
              emptyMessage="No subscriber requests yet">
              <Section dataExpr="ms.collection('subscriber').all().map(|e| { e.sub_badge = if e.is_subscriber { 'SUB' } else { '' }; e })"/>
              <RowAction key="promote" argField="level_id" icon="arrow-up"/>
              <RowAction key="remove"  argField="level_id" style="danger" icon="trash-2"/>
            </List>
          </Tab>
          <Tab label="Viewers" icon="lucide:users" badgeExpr="ms.collection('viewer').count()" showExpr="ms.get_or('sub_mode', false)">
            <List
              rowId="_id"
              primary="username"
              secondary="level_id"
              secondaryPrefix="#"
              platform="platform"
              positionField="position"
              badgeField="sub_badge"
              selectionKey="selected"
              emptyMessage="No viewer requests yet">
              <!-- sub_badge shows a SUB pill even here: this tab is "the viewer
                   collection", not "definitely not a subscriber" — someone lands
                   here whenever Subscriber Priority Mode is off, subscriber or not. -->
              <Section dataExpr="ms.collection('viewer').all().map(|e| { e.sub_badge = if e.is_subscriber { 'SUB' } else { '' }; e })"/>
              <RowAction label="Promote" key="promote" argField="level_id" icon="arrow-up"/>
              <RowAction label="Remove"  key="remove"  argField="level_id" style="danger" icon="trash-2"/>
            </List>
          </Tab>
        </Tabs>

      </Stack>
    </Left>

    <!-- ── Right: selected item detail ───────────────────────────────────── -->
    <Right>
      <Stack fill="true">

        <Conditional showKey="selected">

          <!-- THEN: item selected — header + tabbed detail -->
          <Stack fill="true" gap="0">

            <!-- Compact header: username, level ID, position badge -->
            <Inset padding="14 16 10">
              <Stack direction="horizontal" gap="10" align="center">
                <Stack gap="2" style="flex: 1; min-width: 0;">
                  <Text value="'@' + selected.username"              style="subtitle"/>
                  <Text value="'Level #' + to_string(selected.level_id)" style="muted"/>
                </Stack>
                <Badge value="if selected.position != () { '#' + to_string(selected.position) } else { 'Just played' }" variant="accent"/>
              </Stack>
            </Inset>

            <!-- Tabs: queue actions vs. level data -->
            <Tabs variant="boxed">

              <Tab label="Actions" icon="lucide:zap">
                <!-- Queue entries have a `position`; a just-nexted level (shown via
                     history) doesn't — it's already out of the queue, so Promote/
                     Remove don't apply to it. -->
                <Conditional showExpr="selected.position != ()">
                  <Stack gap="8" style="padding: 14px 16px; flex-shrink: 0;">
                    <!-- Grid, not a horizontal Stack: a fullWidth Button sets width:100%
                         on itself, which in a plain flex row makes EACH button claim the
                         whole row (and refuse to shrink), overflowing it. Grid's 1fr
                         columns actually constrain each button's available width. -->
                    <Grid columns="2" gap="8">
                      <Button label="Move Up"   icon="chevron-up"   actionKey="move_up"   argState="selected.level_id" variant="ghost" fullWidth="true"/>
                      <Button label="Move Down" icon="chevron-down" actionKey="move_down" argState="selected.level_id" variant="ghost" fullWidth="true"/>
                    </Grid>
                    <Button label="Promote to Top"      icon="arrow-up"  actionKey="promote" argState="selected.level_id" variant="ghost"  fullWidth="true"/>
                    <Button label="Remove from Queue"   icon="trash-2"   actionKey="remove"  argState="selected.level_id" variant="danger" fullWidth="true"/>
                    <Divider/>
                    <Button label="Blacklist This Level" icon="ban"    actionKey="add_blacklist_level" argState="selected.level_id" variant="danger" fullWidth="true"/>
                    <Button label="Blacklist Requester"  icon="user-x" actionKey="add_blacklist_user"  argState="selected.username"  variant="danger" fullWidth="true"/>
                  </Stack>
                  <Stack style="padding: 14px 16px;">
                    <CalloutBox kind="note" title="Already played" message="This level has already been popped from the queue — check History for past requests."/>
                  </Stack>
                </Conditional>
              </Tab>

              <Tab label="Level Info" icon="lucide:layers">
                <ScrollArea fill="true">
                  <Stack gap="0">

                    <Conditional showExpr="ms.get_or('gd_enabled', true)">

                      <!-- GD enabled: thumbnail + level fields -->
                      <Stack gap="0">
                        <Conditional showExpr="ms.get_or('gd_thumbnails', true)">
                          <Image
                            srcExpr="'https://levelthumbs.prevter.me/thumbnail/' + to_string(selected.level_id)"
                            height="150"/>
                        </Conditional>
                        <Inset padding="12 16 6">
                          <SectionHeader label="Level Details"/>
                        </Inset>
                        <DetailCard
                          dataExpr="gd.fetch(to_string(selected.level_id))"
                          placeholder="Loading level data…">
                          <Field key="name"        label="Level Name"/>
                          <Field key="difficulty"  label="Difficulty"  type="badge"/>
                          <Field key="stars"       label="Stars"       type="stars"/>
                          <Field key="downloads"   label="Downloads"   type="number"/>
                          <Field key="likes"       label="Likes"       type="number"/>
                          <Field key="length"      label="Length"/>
                          <Field key="is_demon"    label="Demon"       type="boolean"/>
                          <Field key="is_featured" label="Featured"    type="boolean"/>
                          <Field key="is_epic"     label="Epic"        type="boolean"/>
                        </DetailCard>
                      </Stack>

                      <!-- GD disabled: callout -->
                      <Stack style="padding: 14px 16px;">
                        <CalloutBox kind="note" title="GD Integration Disabled" message="Enable GD data in module settings to view level details."/>
                      </Stack>

                    </Conditional>

                  </Stack>
                </ScrollArea>
              </Tab>

            </Tabs>

          </Stack>

          <!-- ELSE: nothing selected -->
          <EmptyState icon="lucide:layers" message="Select a request from the queue to view level details."/>

        </Conditional>

      </Stack>
    </Right>

  </TwoColumn>

  <!-- ── History sub-page ──────────────────────────────────────────────────── -->
  <SubPage id="history">
    <TwoColumn leftWidth="300">

      <Left>
        <Stack fill="true">

          <!-- Header: count + clear action + back navigation -->
          <Stack direction="horizontal" gap="8" align="center" style="padding: 6px 10px; flex-shrink: 0; border-bottom: 1px solid #161616;">
            <Text value="to_string(ms.collection('history').count()) + ' played'" style="muted"/>
            <Spacer/>
            <ActionMenu label="···" variant="ghost">
              <Action label="Clear History" key="clear_history" icon="trash-2" style="danger"/>
            </ActionMenu>
            <Button label="Back" icon="arrow-left" navigateTo=".."/>
          </Stack>

          <List
            rowId="level_id"
            primary="username"
            secondary="level_id"
            secondaryPrefix="#"
            platform="platform"
            badgeField="queue_type"
            selectionKey="history_selected"
            emptyMessage="No levels have been played yet">
            <Section dataExpr="ms.collection('history').all()"/>
          </List>

        </Stack>
      </Left>

      <Right>
        <Stack fill="true">

          <Conditional showKey="history_selected">

            <!-- THEN: history item selected -->
            <Stack fill="true" gap="0">

              <Inset padding="14 16 10">
                <Stack direction="horizontal" gap="10" align="center">
                  <Stack gap="2" style="flex: 1; min-width: 0;">
                    <Text value="'@' + history_selected.username"                  style="subtitle"/>
                    <Text value="'Level #' + to_string(history_selected.level_id)" style="muted"/>
                  </Stack>
                  <Badge value="history_selected.queue_type" variant="default"/>
                </Stack>
              </Inset>

              <Tabs variant="boxed">
                <Tab label="Level Info" icon="lucide:layers">
                  <ScrollArea fill="true">
                    <Stack gap="0">

                      <Conditional showExpr="ms.get_or('gd_enabled', true)">

                        <Stack gap="0">
                          <Conditional showExpr="ms.get_or('gd_thumbnails', true)">
                            <Image
                              srcExpr="'https://levelthumbs.prevter.me/thumbnail/' + to_string(history_selected.level_id)"
                              height="150"/>
                          </Conditional>
                          <Inset padding="12 16 6">
                            <SectionHeader label="Level Details"/>
                          </Inset>
                          <DetailCard
                            dataExpr="gd.fetch(to_string(history_selected.level_id))"
                            placeholder="Loading level data…">
                            <Field key="name"        label="Level Name"/>
                            <Field key="difficulty"  label="Difficulty"  type="badge"/>
                            <Field key="stars"       label="Stars"       type="stars"/>
                            <Field key="downloads"   label="Downloads"   type="number"/>
                            <Field key="likes"       label="Likes"       type="number"/>
                            <Field key="length"      label="Length"/>
                            <Field key="is_demon"    label="Demon"       type="boolean"/>
                            <Field key="is_featured" label="Featured"    type="boolean"/>
                            <Field key="is_epic"     label="Epic"        type="boolean"/>
                          </DetailCard>
                        </Stack>

                        <Stack style="padding: 14px 16px;">
                          <CalloutBox kind="note" title="GD Integration Disabled" message="Enable GD data in module settings to view level details."/>
                        </Stack>

                      </Conditional>

                    </Stack>
                  </ScrollArea>
                </Tab>
              </Tabs>

            </Stack>

            <!-- ELSE: nothing selected -->
            <EmptyState icon="lucide:clock" message="Select a level from the history to view details."/>

          </Conditional>

        </Stack>
      </Right>

    </TwoColumn>
  </SubPage>

</Page>
